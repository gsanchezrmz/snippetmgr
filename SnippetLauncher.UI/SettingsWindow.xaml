<Window x:Class="SnippetLauncher.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings &amp; Snippets" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Smart Import (VS Code &amp; Local)" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Import from Folder..." Width="150" Click="Import_Click"/>
        </StackPanel>

        <TextBlock Text="Global Hotkey Configuration" FontWeight="Bold" Grid.Row="2" Margin="0,0,0,5"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Press new shortcut:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="HotkeyTextBox" Width="200" Padding="5" IsReadOnly="True"
                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                     ToolTip="Click here and press the key combination"/>
        </StackPanel>

        <TextBlock Text="Local Snippets (CRUD)" FontWeight="Bold" Grid.Row="4" Margin="0,0,0,5" VerticalAlignment="Top"/>
        <DataGrid x:Name="SnippetsDataGrid" Grid.Row="4" Margin="0,25,0,15" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="150"/>
                <DataGridTemplateColumn Header="Language" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Language}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Text="{Binding Language}" ItemsSource="{Binding Path=DataContext.Languages, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="150"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save All" Width="100" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="75" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
